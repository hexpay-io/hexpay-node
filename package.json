{
  "name": "@hexpay/sdk",
  "version": "0.0.2",
  "description": "Official Node.js/TypeScript SDK for the HexPay Merchant API supporting TON cryptocurrency payments",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "require": "./dist/client.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "lint": "eslint examples",
    "format": "prettier --write examples",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@hey-api/client-fetch": "^0.13.1"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.97.1",
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hexpay-io/hexpay-node.git"
  },
  "bugs": {
    "url": "https://github.com/hexpay-io/hexpay-node/issues"
  },
  "homepage": "https://hexpay.io",
  "keywords": [
    "hexpay",
    "ton",
    "crypto",
    "payments",
    "merchant",
    "sdk",
    "openapi"
  ],
  "license": "SEE LICENSE IN README.md"
}
